# macOS 元数据（Finder 自动生成）
.DS_Store
**/.DS_Store

# 忽略打包生成的文件夹和配置文件
build/
dist/
*.spec

# 忽略 Python 缓存
__pycache__/
.pycache/
*.py[cod]

# Cython 编译产物（平台相关，由 CI 现编现用，不入库）
*.c
*.so
*.pyd

# License Server 敏感文件兜底（即使 license-server/.gitignore 丢了也挡得住）
license-server/.env
license-server/.wrangler/
license-server/wrangler-account.json
license-server/ADMIN_GUIDE.md
license-server/kv-backups/

# 忽略本地数据库文件（避免把你的测试数据也传到网上）
*.db

# 忽略虚拟环境（如果你有的话）
.venv/
venv/

# 备份文件
backup/
*.bak
*.bak_*
*_bak_*
*.backup_*

# 运行时文件
startup.log
accounting.db

#软著申请文件
智一盈小账_软件设计与使用文档.docx
程序鉴别材料_智一盈小账WiseLedger_V1.0.0.pdf
程序鉴别材料模板_智一盈小账WiseLedger_V1.0.0.docx
截图清单_智一盈小账WiseLedger.xlsx
